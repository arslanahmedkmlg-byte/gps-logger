<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3900FF88"/>
            <size android:width="220dp" android:height="220dp"/>
        </shape>
    </item>
    <!-- Mid glow -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#6600FF88"/>
            <size android:width="200dp" android:height="200dp"/>
        </shape>
    </item>
    <!-- Button face -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#00E676"/>
            <size android:width="180dp" android:height="180dp"/>
        </shape>
    </item>
</layer-list>
